{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/invoice.py": {
      "includeFiles": "data/purchase_orders.csv",
      "excludeFiles": "{node_modules,dist,public}/**",
      "maxDuration": 30
    }
  }
}
